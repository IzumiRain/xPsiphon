        "http": int(location.http_port) if location.http_port.isdigit() else None,
        "config": str(location.config_path),
        "log": str(log_file(paths, location)),
    }


API_ROOT_EXEMPT_CHECKS = {"systemctl available", "systemd running"}


# Failed-auth throttle: the token is 192-bit random, but an operator may set a
# weak XPSIPHON_API_TOKEN, and an externally bound API would otherwise accept
# unbounded guessing. Per-source sliding window; successes clear the counter.
AUTH_FAILURE_WINDOW_SECONDS = 60.0
AUTH_FAILURE_LIMIT = 10
_auth_failures: dict[str, list[float]] = {}
_auth_failures_lock = threading.Lock()


def record_auth_failure(peer: str) -> bool:
    """Record a failed auth attempt for `peer`; True once it exceeds the limit."""
    now = time.monotonic()
    with _auth_failures_lock:
        stamps = [t for t in _auth_failures.get(peer, []) if now - t < AUTH_FAILURE_WINDOW_SECONDS]
        stamps.append(now)
        _auth_failures[peer] = stamps
        return len(stamps) > AUTH_FAILURE_LIMIT


def clear_auth_failures(peer: str) -> None:
    with _auth_failures_lock:
        _auth_failures.pop(peer, None)


def api_status(paths: Paths) -> dict:
    """Full status as a JSON-friendly dict (no color codes)."""
    locations = discover_locations(paths)
    all_pids: list[int] = []
    location_pids: dict[str, list[int]] = {}
    for location in locations:
        pids = running_pids(paths, location)
        location_pids[location.code] = pids
        all_pids.extend(pids)
    proc_info = ps_rows(all_pids)

    items: list[dict] = []
    running_locations = 0
    running_processes = 0
    total_cpu = 0.0
    total_mem = 0.0
    for location in locations:
        processes = []
        location_pids_list = location_pids[location.code]
        if location_pids_list:
            running_locations += 1
        for pid in location_pids_list:
            info = proc_info.get(pid)
            try:
                cpu = float(info.cpu) if info else None
            except ValueError:
                cpu = None
            try:
                mem = float(info.mem) if info else None
            except ValueError:
                mem = None
            rss_kb = int(info.rss) if info and info.rss.isdigit() else None
            if cpu is not None:
                total_cpu += cpu
            if mem is not None:
                total_mem += mem
            running_processes += 1
            processes.append(
                {
                    "pid": pid,
                    "cpu_percent": cpu,
                    "mem_percent": mem,
                    "rss_kb": rss_kb,
                    "rss_human": format_rss(info.rss) if info else None,
                    "uptime": info.elapsed if info else None,
                }
            )
        items.append(
            {
                **location_json(paths, location),
                "state": "running" if location_pids_list else "stopped",
                "processes": processes,
            }
        )

    return {
        "ok": True,
        "version": VERSION,
        "server": dict(server_status()),
        "locations_configured": len(locations),
        "locations_running": running_locations,
        "processes_running": running_processes,
        "aggregate_cpu_percent": round(total_cpu, 1),
        "aggregate_mem_percent": round(total_mem, 1),
        "conf_dir": str(paths.conf_dir),
        "log_dir": str(paths.log_dir),
        "locations": items,
    }


def parse_body_port(data: dict, key: str) -> tuple[int | None, str | None]:
    value = data.get(key)
    if value is None:
        return None, None
    if isinstance(value, bool):
        return None, f"'{key}' must be a port number"
    if isinstance(value, int):
        return value, None
    if isinstance(value, str) and value.isdigit():
        return int(value), None
    return None, f"'{key}' must be a port number"


class ApiRequestHandler(BaseHTTPRequestHandler):
    """Minimal JSON HTTP API over the same core functions the CLI and TUI use."""

    server_version = f"xPsiphon/{VERSION}"
    protocol_version = "HTTP/1.1"
    paths: Paths | None = None
    token: str = ""

    # ---- plumbing ----

    def log_message(self, fmt: str, *args: object) -> None:
        try:
            message = fmt % args
        except (TypeError, ValueError):
            message = fmt
        message = re.sub(r"([?&]token=)[^&\s\"]+", r"\1REDACTED", message)
        sys.stderr.write(f"[api] {self.address_string()} {message}\n")

    def send_json(self, status: int, payload: dict) -> None:
        body = json.dumps(payload, indent=2).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def query_params(self) -> dict[str, list[str]]:
        return parse_qs(urlparse(self.path).query)

    def query_value(self, params: dict[str, list[str]], name: str, default: str) -> str:
        values = params.get(name)
        return values[0] if values else default

    def authorized(self) -> bool:
        expected = self.token
        if not expected:
            return False
        header = self.headers.get("Authorization", "")
        candidate = ""
        if header.startswith("Bearer "):
            candidate = header[len("Bearer "):].strip()
        if not candidate:
            candidate = self.headers.get("X-Api-Token", "").strip()
        # Deliberately no query-parameter form: a token in the URL is
        # world-readable via /proc/<pid>/cmdline and persists in shell
        # history; headers keep it out of both.
        if not candidate:
            return False
        return secrets.compare_digest(candidate, expected)

    def read_body_json(self, limit: int = 64 * 1024) -> tuple[dict | None, str | None]:
        """Read the request body. Returns (data, error); error "__sent__" means a response was already sent."""
        try:
            length = int(self.headers.get("Content-Length", "0") or 0)
        except ValueError:
            return None, "invalid Content-Length"
        if length > limit:
            self.send_json(413, {"ok": False, "error": f"request body too large (limit {limit} bytes)"})
            return None, "__sent__"
        if length <= 0:
            return {}, None
        raw = self.rfile.read(length)
        try:
            data = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            return None, f"invalid JSON body: {exc}"
        if not isinstance(data, dict):
            return None, "JSON body must be an object"
        return data, None

    def require_paths(self) -> Paths:
        if self.paths is None:
            raise RuntimeError("API handler is not configured")
        return self.paths

    # ---- dispatch ----

    def do_GET(self) -> None:
        self.dispatch("GET")

    def do_POST(self) -> None:
        self.dispatch("POST")

    def dispatch(self, method: str) -> None:
        try:
            peer = self.client_address[0]
            if not self.authorized():
                if record_auth_failure(peer):
                    self.send_json(
                        429,
                        {"ok": False, "error": "too many failed authentication attempts; try again later"},
                    )
                    return
                self.send_json(
                    401,
                    {"ok": False, "error": "unauthorized: send the API token as 'Authorization: Bearer <token>'"},
                )
                return
            clear_auth_failures(peer)
            parts = [part for part in urlparse(self.path).path.split("/") if part]
            if method == "GET":
                self.route_get(parts)
            else:
                self.route_post(parts)
        except SystemExit as exc:
            self.send_json(500, {"ok": False, "error": str(exc) or "command failed"})
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception as exc:
            self.send_json(500, {"ok": False, "error": f"{type(exc).__name__}: {exc}"})

    def route_get(self, parts: list[str]) -> None:
        paths = self.require_paths()
        if not parts:
            self.endpoint_index()
        elif parts == ["api", "version"]:
            self.send_json(200, {"ok": True, "version": VERSION, "source": f"{GITHUB_REPO}@{GITHUB_REF}"})
        elif parts == ["api", "status"]:
            self.send_json(200, api_status(paths))
        elif parts == ["api", "locations"]:
            locations = discover_locations(paths)
            self.send_json(
                200,
                {"ok": True, "count": len(locations), "locations": [location_json(paths, loc) for loc in locations]},
            )
        elif len(parts) == 3 and parts[0] == "api" and parts[1] == "logs":
            self.endpoint_logs(parts[2])
        elif parts == ["api", "autostart"]:
            enabled, state = autostart_status(paths)
            self.send_json(200, {"ok": True, "enabled": enabled, "state": state, "service": str(paths.service_path)})
        elif parts == ["api", "doctor"]:
            self.endpoint_doctor()
        else:
            self.send_json(404, {"ok": False, "error": f"no such endpoint: GET /{'/'.join(parts)}"})

    def route_post(self, parts: list[str]) -> None:
        paths = self.require_paths()
        if len(parts) == 3 and parts[0] == "api" and parts[1] in {"start", "stop", "restart"}:
            self.endpoint_lifecycle(parts[1], parts[2])
        elif len(parts) == 3 and parts[0] == "api" and parts[1] == "test":
            self.endpoint_test(parts[2])
        elif len(parts) == 3 and parts[0] == "api" and parts[1] == "autostart":
            self.endpoint_autostart_action(parts[2])
        elif len(parts) == 3 and parts[0] == "api" and parts[1] == "port":
            self.endpoint_port(parts[2])
        else:
            self.send_json(404, {"ok": False, "error": f"no such endpoint: POST /{'/'.join(parts)}"})

    # ---- endpoints ----

    def endpoint_index(self) -> None:
        self.send_json(
            200,
            {
                "ok": True,
                "name": "xPsiphon API",
                "version": VERSION,
                "auth": "Authorization: Bearer <token>",
                "endpoints": {
                    "GET /api/version": "show version",
                    "GET /api/status": "full server and per-location status",
                    "GET /api/locations": "list configured locations",
                    "GET /api/logs/{LOC}?lines=100": "tail one location log",
                    "GET /api/autostart": "show systemd autostart state",
                    "GET /api/doctor": "run doctor checks",
                    "POST /api/start/{LOC|all}": "start locations",
                    "POST /api/stop/{LOC|all}": "stop locations",
                    "POST /api/restart/{LOC|all}": "restart locations",
                    "POST /api/test/{LOC|all}?timeout=20&no_speed=0": "ping/speed test through SOCKS proxies",
                    "POST /api/autostart/{on|off|toggle}": "change systemd autostart",
                    "POST /api/port/{LOC}": "change ports: body {\"socks\": 1201, \"http\": 8201}",
                },
            },
        )

    def endpoint_logs(self, code: str) -> None:
        paths = self.require_paths()
        locations, error = api_resolve_locations(paths, code)
        if error:
            self.send_json(404, {"ok": False, "error": error})
            return
        if len(locations) != 1:
            self.send_json(400, {"ok": False, "error": "logs requires a single location code, not all"})
            return
        location = locations[0]
        params = self.query_params()
        try:
            lines = int(self.query_value(params, "lines", "100"))
        except ValueError:
            lines = 100
        lines = max(1, min(lines, 2000))
        log_path = log_file(paths, location)
        try:
            entries = tail_file(log_path, lines=lines)
        except SystemExit as exc:
            self.send_json(404, {"ok": False, "error": str(exc)})
            return
        self.send_json(200, {"ok": True, "code": location.code, "log": str(log_path), "lines": entries})

    def endpoint_doctor(self) -> None:
        paths = self.require_paths()
        checks = doctor_checks(paths)
        failures = sum(1 for label, ok, _ in checks if not ok and label not in API_ROOT_EXEMPT_CHECKS)
        self.send_json(
            200,
            {
                "ok": failures == 0,
                "checks": [{"check": label, "ok": ok, "detail": detail} for label, ok, detail in checks],
            },
        )

    def endpoint_lifecycle(self, action: str, target: str) -> None:
        paths = self.require_paths()
        locations, error = api_resolve_locations(paths, target)
        if error:
            self.send_json(404, {"ok": False, "error": error})
            return
        if not locations:
            self.send_json(200, {"ok": False, "error": f"no configs found in {paths.conf_dir}"})
            return
        if not api_running_as_root():
            self.send_json(
                403,
                {"ok": False, "error": f"{action} requires root; run the API service as root: sudo {APP_NAME} api start"},
            )
            return
        results = []
        for location in locations:
            if action == "restart":
                messages = restart_location(paths, location)
                results.append({"code": location.code, "action": "restart", "changed": True, "messages": messages})
            elif action == "stop":
                stopped, message = stop_location(paths, location)
                results.append({"code": location.code, "action": "stop", "changed": stopped, "message": message})
            else:
                started, message = start_location(paths, location)
                results.append({"code": location.code, "action": "start", "changed": started, "message": message})
        self.send_json(200, {"ok": True, "results": results})

    def endpoint_test(self, target: str) -> None:
        paths = self.require_paths()
        locations, error = api_resolve_locations(paths, target)
        if error:
            self.send_json(404, {"ok": False, "error": error})
            return
        if not locations:
            self.send_json(200, {"ok": False, "error": f"no configs found in {paths.conf_dir}"})
            return
        if not shutil.which("curl"):
            self.send_json(500, {"ok": False, "error": "curl is required for tunnel testing"})
            return
        params = self.query_params()
        test_url = self.query_value(params, "url", DEFAULT_TEST_URL)
        speed_url = self.query_value(params, "speed_url", DEFAULT_SPEED_URL)
        try:
            timeout = int(self.query_value(params, "timeout", "20"))
        except ValueError:
            timeout = 20
        timeout = max(1, min(timeout, 120))
        include_speed = self.query_value(params, "no_speed", "0").lower() not in {"1", "true", "yes"}
        results = [test_location_once(location, test_url, speed_url, timeout, include_speed) for location in locations]
        ok = all(result["ok"] for result in results) and not any(result["speed_error"] for result in results)
        self.send_json(
            200,
            {
                "ok": ok,
                "test_url": test_url,
                "speed_url": speed_url if include_speed else None,
                "results": results,
            },
        )

    def endpoint_autostart_action(self, action: str) -> None:
        paths = self.require_paths()
        if action not in {"on", "off", "toggle"}:
            self.send_json(404, {"ok": False, "error": f"unknown autostart action: {action}"})
            return
        if not api_running_as_root():
            self.send_json(
                403,
                {"ok": False, "error": f"autostart {action} requires root; run the API service as root: sudo {APP_NAME} api start"},
            )
            return
        command_autostart(paths, action)
        enabled, state = autostart_status(paths)
        self.send_json(200, {"ok": True, "action": action, "enabled": enabled, "state": state})

    def endpoint_port(self, target: str) -> None:
        paths = self.require_paths()
        if target.lower() == "all":
            self.send_json(400, {"ok": False, "error": "port requires a single location code, not all"})
            return
        locations, error = api_resolve_locations(paths, target)
        if error:
            self.send_json(404, {"ok": False, "error": error})
            return
        if not api_running_as_root():
            self.send_json(
                403,
                {"ok": False, "error": f"changing ports requires root; run the API service as root: sudo {APP_NAME} api start"},
            )
            return
        body, body_error = self.read_body_json()
        if body_error:
            if body_error != "__sent__":
                self.send_json(400, {"ok": False, "error": body_error})
            return
        socks_port, socks_error = parse_body_port(body or {}, "socks")
        if socks_error:
            self.send_json(400, {"ok": False, "error": socks_error})
            return
        http_port, http_error = parse_body_port(body or {}, "http")
        if http_error:
            self.send_json(400, {"ok": False, "error": http_error})
            return
        location = locations[0]
        ok, events = port_change_result(paths, location, socks_port, http_port)
        self.send_json(
            200 if ok else 400,
            {
                "ok": ok,
                "code": location.code,
                "events": [{"level": level, "message": message} for level, message in events],
            },
        )


def command_api_serve(paths: Paths, host: str, port: int) -> int:
    """Run the API server in the foreground (Ctrl-C to stop)."""
    if host not in {"127.0.0.1", "localhost", "::1"}:
        print_warning(
            f"API will listen on {host}:{port} and be reachable from the network. "
            "Protect the token and only allow this port from trusted IPs!"
        )
    token = ensure_api_token(paths)
    ApiRequestHandler.paths = paths
    ApiRequestHandler.token = token
    try:
        server = ThreadingHTTPServer((host, port), ApiRequestHandler)
    except OSError as exc:
        raise SystemExit(f"cannot bind API server to {host}:{port}: {exc}") from exc

    print(Color.bold(Color.cyan(f"xPsiphon API  v{VERSION}")))
    print(f"Listening: http://{host}:{port}")
    if os.environ.get("XPSIPHON_API_TOKEN"):
        print("Token:     from XPSIPHON_API_TOKEN environment")
    else:
        print(f"Token:     {paths.api_token_file}")
    print("Auth:      Authorization: Bearer <token>")
    print("Stop:      Ctrl-C")
    sys.stdout.flush()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nAPI server stopped.")
    finally:
        server.server_close()
    return 0


def api_service_unit(paths: Paths, host: str, port: int) -> str:
    environment_lines = [
        f'Environment="XPSIPHON_BIN={paths.psiphon_bin}"',
        f'Environment="XPSIPHON_CONF_DIR={paths.conf_dir}"',
        f'Environment="XPSIPHON_DATA_DIR={paths.data_dir}"',
        f'Environment="XPSIPHON_LOG_DIR={paths.log_dir}"',
        f'Environment="XPSIPHON_RUN_DIR={paths.run_dir}"',
        f'Environment="XPSIPHON_API_TOKEN_FILE={paths.api_token_file}"',
    ]
    return "\n".join(
        [
            "[Unit]",
            "Description=xPsiphon HTTP API server",
            "After=network-online.target",
            "Wants=network-online.target",
            "",
            "[Service]",
            "Type=simple",
            *environment_lines,
            # The API can write the token file, (de)install the tunnel unit,
            # and spawn tunnels — so its writable set is broader than the
            # tunnel unit's, but still bounded.
            *sandbox_directives(
                [
                    paths.data_dir,
                    paths.log_dir,
                    paths.run_dir,
                    paths.api_token_file.parent,
                    paths.service_path.parent,
                ]
            ),
            f"ExecStart={paths.command_path} api serve --host {host} --port {port}",
            "Restart=on-failure",
            "RestartSec=3",
            "",
            "[Install]",
            "WantedBy=multi-user.target",
            "",
        ]
    )


def command_api_start(paths: Paths, host: str, port: int) -> int:
    require_root("starting the API service")
    if not systemd_available():
        raise SystemExit("systemd is not available on this host")
    ensure_api_token(paths)
    paths.api_service_path.write_text(api_service_unit(paths, host, port), encoding="utf-8")
    result = systemctl("daemon-reload")
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or "systemctl daemon-reload failed")
    result = systemctl("enable", "--now", API_SERVICE_NAME)
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or f"systemctl enable {API_SERVICE_NAME} failed")
    print(f"API service started: {API_SERVICE_NAME}")
    print(f"Listening: http://{host}:{port}")
    print(f"Token file: {paths.api_token_file}  (view with: sudo cat {paths.api_token_file})")
    print(f"Check it:   {APP_NAME} api status")
    return 0


def command_api_stop(paths: Paths) -> int:
    require_root("stopping the API service")
    if not systemd_available():
        raise SystemExit("systemd is not available on this host")
    systemctl("disable", "--now", API_SERVICE_NAME)
    if paths.api_service_path.exists():
        paths.api_service_path.unlink()
    result = systemctl("daemon-reload")
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or "systemctl daemon-reload failed")
    print("API service stopped.")
    return 0


def command_api_restart(paths: Paths) -> int:
    require_root("restarting the API service")
    if not paths.api_service_path.exists():
        raise SystemExit(f"API service is not installed. Start it with: sudo {APP_NAME} api start")
    result = systemctl("restart", API_SERVICE_NAME)
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or f"systemctl restart {API_SERVICE_NAME} failed")
    print(f"API service restarted: {API_SERVICE_NAME}")
    return 0


def api_unit_host_port(paths: Paths) -> tuple[str | None, int | None]:
    """Best-effort read of --host/--port from the installed API unit file."""
    try:
        text = paths.api_service_path.read_text(encoding="utf-8")
    except OSError:
        return None, None
    for line in text.splitlines():
        if line.startswith("ExecStart="):
            host_match = re.search(r"--host (\S+)", line)
            port_match = re.search(r"--port (\d+)", line)
            host = host_match.group(1) if host_match else None
            port = int(port_match.group(1)) if port_match else None
            return host, port
    return None, None


def command_api_status(paths: Paths) -> int:
    print(Color.bold(Color.cyan(f"xPsiphon API  v{VERSION}")))
    installed = paths.api_service_path.exists()
    print(f"Service file: {paths.api_service_path} ({'installed' if installed else 'not installed'})")
    host: str | None = None
    port: int | None = None
    if installed:
        result = systemctl("is-active", API_SERVICE_NAME)
        state = result.stdout.strip() or result.stderr.strip() or "unknown"
        print(f"State:        {Color.green(state) if state == 'active' else Color.yellow(state)}")
        result = systemctl("is-enabled", API_SERVICE_NAME)
        enabled_state = result.stdout.strip() or result.stderr.strip() or "unknown"
        print(f"Enabled:      {enabled_state}")
        host, port = api_unit_host_port(paths)
        if host and port:
            print(f"URL:          http://{host}:{port}")
    token_exists = paths.api_token_file.exists()
    print(f"Token file:   {paths.api_token_file} ({'exists' if token_exists else 'not created'})")
    print()
    display_host = host or DEFAULT_API_HOST
    display_port = port or DEFAULT_API_PORT
    print("Test the API:")
    print(f'  curl -s -H "Authorization: Bearer $(sudo cat {paths.api_token_file})" \\\n        http://{display_host}:{display_port}/api/version')
    print(f"Foreground (no systemd): {APP_NAME} api serve")
    return 0


def main(argv: Sequence[str] | None = None) -> int:
    paths = build_paths()
    parser = build_parser()
    args = parser.parse_args(argv)

    try:
        if args.command is None:
            return interactive(paths)
        if args.command == "status":
            return print_status(paths)
        if args.command == "start":
            return command_start(paths, args.target)
        if args.command == "stop":
            return command_stop(paths, args.target)
        if args.command == "restart":
            return command_restart(paths, args.target)
        if args.command == "logs":
            return command_logs(paths, args.target, args.follow, max(args.lines, 1))
        if args.command == "autostart":
            return command_autostart(paths, args.action)
        if args.command in {"test", "speed"}:
            return command_test(paths, args.target, args.url, args.speed_url, max(args.timeout, 1), not args.no_speed)
        if args.command == "port":
            require_root("changing location ports")
            return command_port(paths, args.target, args.socks, args.http)
        if args.command == "api":
            if args.api_command == "serve":
                return command_api_serve(paths, args.host, args.port)
            if args.api_command == "start":
                return command_api_start(paths, args.host, args.port)
            if args.api_command == "stop":
                return command_api_stop(paths)
            if args.api_command == "restart":
                return command_api_restart(paths)
            if args.api_command == "status":
                return command_api_status(paths)
            return command_api_status(paths)
        if args.command == "update":
            return command_update(paths, args.force_psiphon, args.force_configs)
        if args.command == "uninstall":
            return command_uninstall(paths, args.purge, args.yes)
        if args.command == "version":
            return command_version()
        if args.command == "doctor":
            return doctor(paths)
        if args.command in {"firewall", "ports"}:
            return command_firewall(paths)
        if args.command == "locations":
            return command_locations(paths)
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        print()
        return 130
    except SystemExit:
        raise
    except Exception as exc:
        print_error(str(exc))
        return 1

    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
