def command_update(paths: Paths, force_psiphon: bool, force_configs: bool) -> int:
    """Update xPsiphon in place by re-running the bootstrap installer.

    This is intentionally non-destructive: the installer keeps existing location
    configs (so customized ports survive), keeps the Psiphon core binary unless
    --force-psiphon is given, and never stops running tunnels or changes the
    autostart state. New location configs are simply added.
    """
    require_root("updating xPsiphon")
    if not shutil.which("curl"):
        raise SystemExit("curl is required to update. Install curl and retry.")
    if not shutil.which("bash"):
        raise SystemExit("bash is required to update.")

    print(Color.bold(Color.cyan("xPsiphon Update")))
    print(f"Installed version: {VERSION}")
    print(f"Installer:         {INSTALLER_URL}")
    print("Existing configs, customized ports, and running tunnels are preserved.")
    print()

    before = {loc.code for loc in discover_locations(paths)}

    fd, tmp_installer = tempfile.mkstemp(prefix="xpsiphon-install-", suffix=".sh")
    os.close(fd)
    try:
        code, out, err = run_text(
            ["curl", "-fsSL", "--retry", "3", "--connect-timeout", "20", INSTALLER_URL, "-o", tmp_installer]
        )
        if code != 0:
            detail = err.strip() or out.strip() or f"curl exit {code}"
            raise SystemExit(f"failed to download installer from {INSTALLER_URL}: {detail}")

        installer_args = ["bash", tmp_installer]
        if force_psiphon:
            installer_args.append("--force-psiphon")
        if force_configs:
            installer_args.append("--force-configs")

        result = subprocess.run(installer_args, check=False)
        if result.returncode != 0:
            raise SystemExit(f"installer exited with code {result.returncode}")
    finally:
        try:
            os.unlink(tmp_installer)
        except OSError:
            pass

    after = {loc.code for loc in discover_locations(paths)}
    added = sorted(after - before)

    print()
    print(Color.green("Update complete."))
    if added:
        print(f"New locations added: {', '.join(added)}")
        print(f"They are not started automatically. Start them when ready:")
        print(f"  sudo {APP_NAME} start all")
    print(f"Confirm the new version with: {APP_NAME} version")
    return 0


def uninstall_command_paths(paths: Paths) -> list[Path]:
    """Every path the xpsiphon/xp commands may live at, de-duplicated."""
    candidates: list[Path] = [Path(paths.command_path)]
    for name in (APP_NAME, SHORT_NAME):
        found = shutil.which(name)
        if found:
            candidates.append(Path(found))
        candidates.append(Path(f"/usr/local/bin/{name}"))
        # The installer adds /usr/bin aliases so `sudo xp ...` also works on
        # RHEL-family distros, whose sudo secure_path omits /usr/local/bin.
        candidates.append(Path(f"/usr/bin/{name}"))

    seen: set[str] = set()
    unique: list[Path] = []
    for candidate in candidates:
        key = str(candidate)
        if key not in seen:
            seen.add(key)
            unique.append(candidate)
    return unique


def command_uninstall(paths: Paths, purge: bool, assume_yes: bool) -> int:
    require_root("uninstalling xPsiphon")

    psiphon_dir = paths.psiphon_bin.parent
    print(Color.bold(Color.cyan("xPsiphon Uninstall")))
    print("This will:")
    print("  - stop all running Psiphon locations")
    print(f"  - disable and remove {SERVICE_NAME}")
    print(f"  - disable and remove {API_SERVICE_NAME} (if installed)")
    print(f"  - remove the {APP_NAME} and {SHORT_NAME} commands")
    print(f"  - remove runtime dirs: {paths.run_dir}, {paths.log_dir}, {paths.data_dir}")
    if purge:
        print(Color.yellow(f"  - PURGE configs ({paths.conf_dir}) and Psiphon binary ({paths.psiphon_bin})"))
    else:
        print(f"  - keep configs and Psiphon binary in {psiphon_dir}")
    print()

    if not assume_yes:
        if not sys.stdin.isatty():
            raise SystemExit("refusing to uninstall without confirmation; re-run with --yes")
        answer = input("Type 'yes' to continue: ").strip().lower()
        if answer not in {"yes", "y"}:
            print("Aborted.")
            return 1

    for location in discover_locations(paths):
        try:
            stop_location(paths, location)
        except SystemExit as exc:
            print_warning(str(exc))

    if systemd_available():
        systemctl("disable", SERVICE_NAME)
    if paths.service_path.exists():
        try:
            paths.service_path.unlink()
            print(f"removed {paths.service_path}")
        except OSError as exc:
            print_warning(f"could not remove {paths.service_path}: {exc}")
    if systemd_available():
        systemctl("disable", API_SERVICE_NAME)
    if paths.api_service_path.exists():
        try:
            paths.api_service_path.unlink()
            print(f"removed {paths.api_service_path}")
        except OSError as exc:
            print_warning(f"could not remove {paths.api_service_path}: {exc}")
    if systemd_available():
        systemctl("daemon-reload")

    for command_file in uninstall_command_paths(paths):
        try:
            if command_file.exists() or command_file.is_symlink():
                command_file.unlink()
                print(f"removed {command_file}")
        except OSError as exc:
            print_warning(f"could not remove {command_file}: {exc}")

    for directory in (paths.run_dir, paths.log_dir, paths.data_dir):
        if directory.exists():
            shutil.rmtree(directory, ignore_errors=True)
            print(f"removed {directory}")

    if purge:
        if paths.conf_dir.exists():
            shutil.rmtree(paths.conf_dir, ignore_errors=True)
            print(f"removed {paths.conf_dir}")
        # The API token is a credential on disk, so a purge must take it too —
        # leaving it behind also keeps /etc/psiphon alive after the rmdir below.
        if paths.api_token_file.exists():
            try:
                paths.api_token_file.unlink()
                print(f"removed {paths.api_token_file}")
            except OSError as exc:
                print_warning(f"could not remove {paths.api_token_file}: {exc}")
        if paths.psiphon_bin.exists():
            try:
                paths.psiphon_bin.unlink()
                print(f"removed {paths.psiphon_bin}")
            except OSError as exc:
                print_warning(f"could not remove {paths.psiphon_bin}: {exc}")
        try:
            if psiphon_dir.exists() and not any(psiphon_dir.iterdir()):
                psiphon_dir.rmdir()
                print(f"removed {psiphon_dir}")
        except OSError:
            pass

    print()
    print(Color.green("xPsiphon uninstalled."))
    if not purge:
        print(f"Configs and Psiphon binary were kept in {psiphon_dir}.")
        print(f"Remove them too with: sudo rm -rf {psiphon_dir}")
        if paths.api_token_file.exists():
            print(f"The API token was kept: {paths.api_token_file} (delete it if no longer needed)")
    return 0


