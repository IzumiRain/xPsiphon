def valid_port(value: int) -> bool:
    return 1 <= value <= 65535


def port_conflicts(
    paths: Paths,
    location: Location,
    socks_port: int | None,
    http_port: int | None,
) -> list[str]:
    """Return human-readable conflicts for the requested ports.

    Checks the two new ports against each other and against every OTHER
    location's SOCKS and HTTP ports so two locations never share a port.
    """
    problems: list[str] = []
    new_socks = socks_port if socks_port is not None else (int(location.socks_port) if location.socks_port.isdigit() else None)
    new_http = http_port if http_port is not None else (int(location.http_port) if location.http_port.isdigit() else None)

    if new_socks is not None and new_http is not None and new_socks == new_http:
        problems.append(f"SOCKS and HTTP cannot both use port {new_socks}")

    for other in discover_locations(paths):
        if other.code == location.code:
            continue
        used: dict[int, str] = {}
        if other.socks_port.isdigit():
            used[int(other.socks_port)] = f"{other.code} SOCKS"
        if other.http_port.isdigit():
            used[int(other.http_port)] = f"{other.code} HTTP"
        for new_port, label in ((new_socks, "SOCKS"), (new_http, "HTTP")):
            if new_port is not None and new_port in used:
                problems.append(f"{label} port {new_port} already used by {used[new_port]}")
    return problems


def write_location_ports(
    location: Location,
    socks_port: int | None,
    http_port: int | None,
) -> None:
    """Persist new port values to the location's JSON config, preserving key order."""
    data = read_json_config(location.config_path)
    if socks_port is not None:
        data["LocalSocksProxyPort"] = socks_port
    if http_port is not None:
        data["LocalHttpProxyPort"] = http_port
    # Atomic replace so a crash or full disk cannot leave a truncated config.
    tmp_path = location.config_path.with_name(location.config_path.name + ".tmp")
    try:
        tmp_path.write_text(json.dumps(data, indent=2, sort_keys=False) + "\n", encoding="utf-8")
        os.replace(tmp_path, location.config_path)
    finally:
        tmp_path.unlink(missing_ok=True)


def port_change_result(
    paths: Paths,
    location: Location,
    socks_port: int | None,
    http_port: int | None,
) -> tuple[bool, list[tuple[str, str]]]:
    """Validate and apply a port change.

    Returns (ok, events) where each event is (level, message) with level one of
    "info", "warning", or "error". Shared by the CLI and the HTTP API.
    """
    events: list[tuple[str, str]] = []

    def add(level: str, message: str) -> None:
        events.append((level, message))

    if socks_port is None and http_port is None:
        add("error", "provide a new socks and/or http port")
        return False, events

    for label, value in (("SOCKS", socks_port), ("HTTP", http_port)):
        if value is not None and not valid_port(value):
            add("error", f"{label} port {value} is out of range (1-65535)")
            return False, events
        if value is not None and value < 1024:
            add("warning", f"{label} port {value} is privileged (<1024); binding may need root")

    problems = port_conflicts(paths, location, socks_port, http_port)
    if problems:
        for problem in problems:
            add("error", problem)
        return False, events

    old_socks, old_http = location.socks_port, location.http_port
    write_location_ports(location, socks_port, http_port)

    new_socks = str(socks_port) if socks_port is not None else old_socks
    new_http = str(http_port) if http_port is not None else old_http
    add("info", f"{location.code}: SOCKS {old_socks} -> {new_socks} | HTTP {old_http} -> {new_http}")
    add("info", f"Updated {location.config_path}")

    if running_pids(paths, location):
        add("warning", f"{location.code} is running; restart it to apply the new ports:")
        add("info", f"  sudo {APP_NAME} restart {location.code}")
    return True, events


def apply_location_ports(
    paths: Paths,
    location: Location,
    socks_port: int | None,
    http_port: int | None,
) -> int:
    ok, events = port_change_result(paths, location, socks_port, http_port)
    for level, message in events:
        if level == "error":
            print_error(message)
        elif level == "warning":
            print_warning(message)
        else:
            print(message)
    return 0 if ok else 1


def command_port(paths: Paths, target: str, socks_port: int | None, http_port: int | None) -> int:
    locations = resolve_locations(paths, target)
    if len(locations) != 1:
        raise SystemExit("port command requires a single location code, not all")
    return apply_location_ports(paths, locations[0], socks_port, http_port)


def prompt_port_change(paths: Paths) -> None:
    location = prompt_location(paths)
    if not location:
        return
    print(f"\n{location.code} current ports: SOCKS {location.socks_port} | HTTP {location.http_port}")
    print("Leave a field blank to keep its current value.")

    def ask(label: str, current: str) -> int | None:
        value = input(f"New {label} port [{current}]: ").strip()
        if not value:
            return None
        if not value.isdigit():
            print_error(f"{label} port must be a number")
            raise ValueError(value)
        return int(value)

    try:
        socks_port = ask("SOCKS", location.socks_port)
        http_port = ask("HTTP", location.http_port)
    except ValueError:
        return
    apply_location_ports(paths, location, socks_port, http_port)


