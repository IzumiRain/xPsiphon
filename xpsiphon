def api_running_as_root() -> bool:
    return not hasattr(os, "geteuid") or os.geteuid() == 0


def ensure_api_token(paths: Paths, quiet: bool = False) -> str:
    """Return the API token, creating the token file on first use.

    XPSIPHON_API_TOKEN always wins over the token file, so operators can
    rotate the token without touching disk.
    """
    env_token = os.environ.get("XPSIPHON_API_TOKEN", "").strip()
    if env_token:
        return env_token

    token = ""
    try:
        token = paths.api_token_file.read_text(encoding="utf-8").strip()
    except OSError:
        token = ""
    if token:
        return token

    token = secrets.token_hex(24)
    try:
        paths.api_token_file.parent.mkdir(parents=True, exist_ok=True)
        # Create with 0600 from the start: write_text + chmod leaves a
        # world-readable window on multi-user hosts.
        fd = os.open(paths.api_token_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(token + "\n")
    except OSError as exc:
        raise SystemExit(f"cannot write API token file {paths.api_token_file}: {exc}") from exc
    if not quiet:
        print(f"Generated API token file: {paths.api_token_file}")
    return token


def api_resolve_locations(paths: Paths, target: str) -> tuple[list[Location], str | None]:
    """Resolve a location target for the API: returns (locations, error)."""
    locations = discover_locations(paths)
    if target.lower() == "all":
        return locations, None
    code = normalize_code(target)
    for location in locations:
        if location.code == code:
            return [location], None
    available = ", ".join(location.code for location in locations) or "none"
    return [], f"unknown location '{target}'. Available locations: {available}"


