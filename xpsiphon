            elif choice == "t":
                clear_screen()
                command_test(paths, "all", DEFAULT_TEST_URL, DEFAULT_SPEED_URL, 20, True)
                pause()
            elif choice == "d":
                clear_screen()
                doctor(paths)
                pause()
            elif choice == "u":
