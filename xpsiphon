def env_path(name: str, default: str) -> Path:
    return Path(os.environ.get(name, default)).expanduser()


def go_runtime_env() -> dict[str, str]:
    """Optional Go runtime tuning for the tunnel processes.

    Off by default: the Go runtime's own defaults are a safe baseline, and
    forcing an aggressive GC or a hard memory limit can raise CPU use on small
    servers. Operators who want to trade CPU for a smaller resident set can
    opt in per install:

        XPSIPHON_GOGC=50
        XPSIPHON_GOMEMLIMIT=45MiB

    An explicit XPSIPHON_* value wins over an inherited GOGC/GOMEMLIMIT, so the
    manager's own setting is always the one that takes effect.
    """
    env: dict[str, str] = {}
    gogc = os.environ.get("XPSIPHON_GOGC", "").strip()
    if gogc:
        env["GOGC"] = gogc
    gomemlimit = os.environ.get("XPSIPHON_GOMEMLIMIT", "").strip()
    if gomemlimit:
        env["GOMEMLIMIT"] = gomemlimit
    return env


